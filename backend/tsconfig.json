{
  // Chỉ dùng để kiểm tra kiểu (npm run typecheck); code vẫn chạy trực tiếp bằng Node, không biên dịch.
  // File có dòng "// @ts-check" được kiểm tra theo các interface trong src/interfaces.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "scripts/**/*.js"]
}
